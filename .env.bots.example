# Merge with the existing server .env; do not replace existing credentials.
# Select BOT_PROFILE per process (Compose already selects prod for public bots).
BOT_PROFILE=test
# Paths inside the existing bot/web/tg containers (/opt/bot is mounted at /app).
# compose.bots.yml maps the same host data at /data for the public containers.
DATABASE_PATH=/app/guild_management.db
SHARED_CACHE_DIR=/app/cache

PROD_DISCORD_TOKEN=
PROD_DISCORD_CLIENT_ID=
PROD_DISCORD_CLIENT_SECRET=
PROD_TELEGRAM_BOT_TOKEN=

# Enable only after both public workers and command registration are verified.
PROD_BOTS_READY=0
WEB_PUBLIC_PROFILE=test

# Public image can be built from a stable checkout independent of /opt/bot.
PUBLIC_BOT_CODE_DIR=/opt/bot-public
PUBLIC_BOT_RELEASE=local
BOT_ENV_FILE=/opt/bot/.env
BOT_SHARED_DATA_DIR=/opt/bot
PUBLIC_BOT_MEMORY_LIMIT=1536m
